# Copy to .generated/docker/compose.env, or let `python -m nighthawk quickstart-docker` write it.
# This file holds no secret. Secrets reach containers only as files under NIGHTHAWK_SECRETS_DIR.

COMPOSE_PROJECT_NAME=nighthawk

# Rendered, non-secret configuration and the materialized secrets (absolute paths).
NIGHTHAWK_RENDERED_DIR=/absolute/path/to/NightHawk/.generated/docker
NIGHTHAWK_SECRETS_DIR=/absolute/path/to/NightHawk/.materialized-secrets

# Every service runs as this user so it can read the owner-only secret files.
# Docker Engine: your own UID and GID. Rootless Podman: 0 and 0, which is you outside the container.
NIGHTHAWK_UID=1000
NIGHTHAWK_GID=1000

# Address the gateway is published on. Loopback unless you deliberately expose it.
NIGHTHAWK_BIND_ADDRESS=127.0.0.1

# Host names from the platform document's gateway and grafana blocks.
NIGHTHAWK_GATEWAY_HOSTNAME=gateway.nighthawk.internal
NIGHTHAWK_GRAFANA_HOSTNAME=grafana.nighthawk.internal
