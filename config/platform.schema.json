{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nighthawk:platform:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deployment", "profile", "vault", "gateway", "grafana", "storage", "secrets", "credentials", "tenants"],
  "properties": {
    "schema_version": {"const": 2},
    "deployment": {"enum": ["docker", "self-hosted-k8s", "aws"]},
    "profile": {"enum": ["development", "production"]},
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "kv_mount", "pki"],
      "properties": {
        "address": {"type": "string", "pattern": "^https?://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?$"},
        "namespace": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(/[A-Za-z0-9][A-Za-z0-9_-]*)*$"},
        "ca_file": {"type": "string", "pattern": "^/[^\\s]+$"},
        "kv_mount": {"$ref": "#/$defs/vault_path"},
        "pki": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mount", "server_role", "client_role"],
          "properties": {
            "mount": {"$ref": "#/$defs/vault_path"},
            "server_role": {"$ref": "#/$defs/id"},
            "client_role": {"$ref": "#/$defs/id"}
          }
        },
        "kubernetes_auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mount"],
          "properties": {
            "mount": {"$ref": "#/$defs/vault_path"},
            "cluster_address": {"type": "string", "pattern": "^https?://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?$"}
          }
        }
      }
    },
    "gateway": {"$ref": "#/$defs/gateway"},
    "grafana": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "admin_secret_ref"],
      "properties": {
        "hostname": {"$ref": "#/$defs/hostname"},
        "admin_secret_ref": {"$ref": "#/$defs/id"}
      }
    },
    "storage": {"$ref": "#/$defs/storage"},
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["join_token_secret_ref"],
      "properties": {
        "join_token_secret_ref": {"$ref": "#/$defs/id"}
      }
    },
    "secrets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "key"],
        "properties": {
          "path": {"$ref": "#/$defs/vault_path"},
          "key": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"}
        }
      }
    },
    "credentials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "secret_ref", "tenant", "datastream", "permission"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "secret_ref": {"$ref": "#/$defs/id"},
          "tenant": {"$ref": "#/$defs/id"},
          "datastream": {"$ref": "#/$defs/id"},
          "permission": {"enum": ["ingest", "query"]},
          "certificate_identity": {"type": "string", "pattern": "^spiffe://nighthawk/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"}
        }
      }
    },
    "tenants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "datastreams"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "datastreams": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "backend_id", "signals", "collection"],
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "backend_id": {"$ref": "#/$defs/id"},
                "signals": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "properties": {
                    "metrics": {"$ref": "#/$defs/metrics_signal"},
                    "logs": {"$ref": "#/$defs/signal"},
                    "traces": {"$ref": "#/$defs/signal"},
                    "profiles": {"$ref": "#/$defs/signal"}
                  }
                },
                "collection": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["approved", "drop_fields", "allow_privileged_profiling"],
                  "properties": {
                    "approved": {"const": true},
                    "drop_fields": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
                    },
                    "allow_privileged_profiling": {"type": "boolean"}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "vault_path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$"},
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention", "ingestion_rate_bytes_per_second", "query_concurrency"],
      "properties": {
        "retention": {"type": "string", "maxLength": 8, "pattern": "^[1-9][0-9]*h$"},
        "ingestion_rate_bytes_per_second": {"type": "integer", "minimum": 1},
        "query_concurrency": {"type": "integer", "minimum": 1}
      }
    },
    "metrics_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention", "ingestion_rate_samples_per_second", "query_concurrency"],
      "properties": {
        "retention": {"type": "string", "maxLength": 8, "pattern": "^[1-9][0-9]*h$"},
        "ingestion_rate_samples_per_second": {"type": "integer", "minimum": 1},
        "query_concurrency": {"type": "integer", "minimum": 1}
      }
    },
    "hostname": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"},
    "origin": {"type": "string", "pattern": "^https?://[a-z0-9]([a-z0-9.-]*[a-z0-9])?:[0-9]{1,5}$"},
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "entry_points", "grafana_entry_point", "auth_service", "upstreams", "revoked_certificate_fingerprints"],
      "properties": {
        "hostname": {"$ref": "#/$defs/hostname"},
        "entry_points": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "grafana_entry_point": {"$ref": "#/$defs/id"},
        "auth_service": {"$ref": "#/$defs/origin"},
        "upstreams": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grafana"],
          "properties": {
            "grafana": {"$ref": "#/$defs/origin"},
            "metrics": {"$ref": "#/$defs/origin"},
            "logs": {"$ref": "#/$defs/origin"},
            "traces": {
              "type": "object",
              "additionalProperties": false,
              "required": ["query", "otlp_grpc", "otlp_http"],
              "properties": {
                "query": {"$ref": "#/$defs/origin"},
                "otlp_grpc": {"type": "string", "pattern": "^(h2c|https)://[a-z0-9]([a-z0-9.-]*[a-z0-9])?:[0-9]{1,5}$"},
                "otlp_http": {"$ref": "#/$defs/origin"}
              }
            },
            "profiles": {"$ref": "#/$defs/origin"}
          }
        },
        "revoked_certificate_fingerprints": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "bindings"],
      "properties": {
        "provider": {"enum": ["seaweedfs", "aws"]},
        "bindings": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"enum": ["mimir-blocks", "mimir-ruler", "mimir-alertmanager", "loki-chunks", "loki-ruler", "tempo-traces", "pyroscope-profiles"]},
          "additionalProperties": {"$ref": "#/$defs/binding"}
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "endpoint", "region", "bucket", "force_path_style", "tls", "identity", "capabilities"],
      "properties": {
        "protocol": {"const": "s3"},
        "endpoint": {"type": "string", "minLength": 1},
        "region": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "bucket": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},
        "force_path_style": {"type": "boolean"},
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "ca_secret_ref"],
          "properties": {
            "enabled": {"const": true},
            "trust": {"enum": ["system", "pki", "secret"]},
            "ca_secret_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ref"],
          "properties": {
            "type": {"enum": ["secret", "irsa"]},
            "ref": {"type": "string", "minLength": 1}
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["versioning", "lifecycle", "workload_identity"],
          "properties": {
            "versioning": {"type": "boolean"},
            "lifecycle": {"type": "boolean"},
            "workload_identity": {"type": "boolean"}
          }
        }
      }
    }
  }
}
