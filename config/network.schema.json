{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "destination", "protocol", "port", "purpose", "scope", "direction"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "source": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "destination": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "protocol": {"enum": ["tcp", "udp"]},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "purpose": {"type": "string", "pattern": "^[^|\\r\\n]+$"},
          "scope": {"enum": ["loopback", "private", "restricted-external"]},
          "direction": {"const": "source-to-destination"}
        }
      }
    }
  }
}
