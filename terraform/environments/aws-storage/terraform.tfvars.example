region      = "eu-west-1"
account_id  = "123456789012"
name_prefix = "replace-with-unique-prefix"

aws_identity = {
  oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/oidc.eks.eu-west-1.amazonaws.com/id/REPLACE"
  oidc_issuer_url   = "https://oidc.eks.eu-west-1.amazonaws.com/id/REPLACE"
}

# These must match the actual service accounts supplied to the Grafana charts.
workloads = {
  mimir     = { namespace = "observability", service_accounts = ["mimir"] }
  loki      = { namespace = "observability", service_accounts = ["loki"] }
  tempo     = { namespace = "observability", service_accounts = ["tempo"] }
  pyroscope = { namespace = "observability", service_accounts = ["pyroscope"] }
}

versioning        = { enabled = false }
enable_loki_ruler = false
tags              = { Environment = "production" }
