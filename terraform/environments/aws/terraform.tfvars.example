region      = "eu-west-1"
account_id  = "123456789012"
name_prefix = "replace-with-unique-prefix"

vpc_cidr = "10.0.0.0/16"
az_count = 2

# How the cluster API is reached, and who administers it. There are no defaults.
# The private endpoint is always on. A private-only cluster needs a network path
# into the VPC (VPN, peering, or a bastion) that you arrange yourself.
endpoint_public_access = true
public_access_cidrs    = ["203.0.113.0/24"] # your own ranges; a range covering every address is refused
# The principal that creates the cluster gets no access on its own.
cluster_admin_principal_arns = ["arn:aws:iam::123456789012:role/replace-with-admin-role"]

# Optional. Leave unset to let the module create a key with rotation enabled.
# secrets_kms_key_arn = "arn:aws:kms:eu-west-1:123456789012:key/00000000-0000-0000-0000-000000000000"

# Optional controller identities. Each role can be assumed only by the named
# service account. Installing the controllers themselves is a later step.
# dns_controller = {
#   service_account = { namespace = "external-dns", name = "external-dns" }
#   hosted_zone_ids = ["Z0123456789ABC"]
# }
# certificate_controller = {
#   service_account = { namespace = "cert-manager", name = "cert-manager" }
#   hosted_zone_ids = ["Z0123456789ABC"]
# }
# autoscaler_controller = {
#   service_account = { namespace = "kube-system", name = "cluster-autoscaler" }
# }

cluster_version       = "1.37"
ebs_csi_addon_version = "v1.66.0-eksbuild.1"

stateful_node_group = {
  desired_size = 2
  min_size     = 2
  max_size     = 4
}

stateless_node_group = {
  desired_size  = 1
  min_size      = 0
  max_size      = 4
  capacity_type = "ON_DEMAND"
}

tags = { Environment = "production" }
